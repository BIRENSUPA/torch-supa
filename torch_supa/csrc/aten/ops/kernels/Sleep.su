#include <supa.h>
#include <time.h>

#undef __OPENCL_VERSION__
#include "torch_supa/csrc/core/supa/SUPAStream.h"
#include <iostream>

namespace at {
namespace supa {
namespace {

__global__ void spin_kernel(int64_t cycles) {
  int64_t start_clock = clock64();
  int64_t clock_offset = 0;
  while (clock_offset < cycles) {
    clock_offset = clock64() - start_clock;
  }
}

} // anonymous namespace

void sleep_kernel(int64_t cycles, supaStream_t stream) {
  dim3 grid(1);
  dim3 block(1);
  spin_kernel<<<grid, block, 0, c10::supa::getCurrentSUPAStream()>>>(cycles);
}

} // namespace supa
} // namespace at
