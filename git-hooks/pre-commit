#!/usr/bin/env python3

import sys
import re
import subprocess
import os


def validate_python_files(file_list, ci_mode=False):
    py_files = [f for f in file_list if f.endswith(".py")]
    if not py_files:
        return 0
    try:
        subprocess.run(["flake8", "--version"], check=True, stdout=subprocess.DEVNULL)
    except:
        if ci_mode:
            print("flake8 not installed, installing now...")
            subprocess.run(["pip", "install", "flake8"], check=True)
        else:
            print("flake8 not installed，please run: pip install flake8")
            return 1

    print("Running Python format checks")

    flake8_cmd = ["flake8", "--config=.flake8"] + py_files
    try:
        proc = subprocess.run(flake8_cmd, capture_output=True, text=True, check=True)
        print("All Python files passed format check")
        return 0
    except subprocess.CalledProcessError as e:
        print("\n" + "=" * 60)
        print("Python format check failed：")
        print("=" * 60)
        errors = {}
        for line in e.stdout.splitlines():
            match = re.match(r"^(.+?):(\d+):(\d+): (\w+) (.+)$", line)
            if match:
                filename, line, col, code, msg = match.groups()
                if filename not in errors:
                    errors[filename] = []
                errors[filename].append(f"  L{line}:{col} {code} - {msg}")

        for filename, msgs in errors.items():
            print(f"\n {filename}:")
            print("\n".join(msgs))

        print("Fix suggestions:")
        print("1. Use 'flake8 <filename>' to view specific errors")
        print("2. Use 'black --line-length 120  <filename>' to fix most errors")
        print("3. After fixing, execute 'git add <file>'")

        return 1


def get_staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        stdout=subprocess.PIPE,
    ).stdout.decode()
    return result.split()


def get_changed_files_from_branch(target_branch):
    result = subprocess.run(
        [
            "git",
            "diff",
            "--name-only",
            f"software/torch-supa/{target_branch}...",
            "--diff-filter=ACM",
        ],
        stdout=subprocess.PIPE,
    ).stdout.decode()
    return result.split()


def main():
    home = os.path.expanduser("~")
    local_bin = os.path.join(home, ".local", "bin")
    os.environ["PATH"] = f"{local_bin}:{os.environ['PATH']}"
    ci_mode = os.getenv("CI") in {"1", "true", "TRUE"}
    if ci_mode:
        print(os.getenv("glmrTargetBranch"))
        target_branch = os.getenv("glmrTargetBranch", "develop_br200")
        files = get_changed_files_from_branch(target_branch)
        print(f"CI mode: Checking {len(files)} files that differ from branch {target_branch}")
    else:
        files = get_staged_files()
        print(f"Local commit: Checking {len(files)} files in the staging area")

    return validate_python_files(files, ci_mode)


if __name__ == "__main__":
    sys.exit(main())
